INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# topf resolves patches/ and secretsPath relative to topf.yaml's directory,
# so topf commands work from anywhere in the repo.
export TOPFCONFIG="$INFRA/talos/topf.yaml"

# Generated client configs (gitignored):
#   topf talosconfig > talos/talosconfig
#   topf kubeconfig  > talos/kubeconfig   # 12h admin cert, regenerate as needed
export TALOSCONFIG="$INFRA/talos/talosconfig"
export KUBECONFIG="$INFRA/talos/kubeconfig"

# OCI control plane public address
export OCI_IP="140.238.213.197"

# rbpi worker private address
export RBPI_IP="10.10.20.10"
