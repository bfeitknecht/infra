#!/usr/bin/env bash
# One interactive browsh per SSH session: fresh HOME and Firefox profile, a
# 12h guard. One session at a time:
# browsh hard-codes Marionette 2828 and exits beside another headless
# Firefox.
set -euo pipefail

# sshd sessions get the default PATH, not the image ENV: browsh and its
# Firefox live in /app/bin.
export PATH="/app/bin:/app/bin/firefox:/usr/local/bin:/usr/bin:/bin"

# The lock fd stays open through exec: held for the whole session.
exec 9>/tmp/browser-session.lock
if ! flock -n 9; then
  echo "browser: a session is already running (one at a time)." >&2
  exit 1
fi
# A dropped session can leave its Firefox behind; browsh refuses to start
# beside it. The lock proves no other session owns one.
pkill -u "$(id -u)" -f firefox 2>/dev/null || true
sleep 0.5

export HOME="$(mktemp -d /tmp/session.XXXXXX)"
chmod 700 "$HOME"
export XDG_CONFIG_HOME="$HOME/.config"
# browsh unpacks its webext to $TMPDIR/browsh-webext-addon.
export TMPDIR="$HOME"

# Browsh keeps its Firefox profile in XDG_CONFIG_HOME/browsh/firefox_profile;
# the fresh XDG_CONFIG_HOME makes it session-private.
install -d -m 700 "$XDG_CONFIG_HOME/browsh/firefox_profile"
cat > "$XDG_CONFIG_HOME/browsh/firefox_profile/user.js" <<'JS'
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
JS
install -d -m 700 "$XDG_CONFIG_HOME/browsh"
install -m 644 /etc/browsh/config.toml "$XDG_CONFIG_HOME/browsh/config.toml"

exec timeout --signal=TERM --kill-after=10 12h browsh
