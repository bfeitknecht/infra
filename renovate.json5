{
  // Renovate for the infra tree: the shared preset (renovate/default.json5)
  // plus the infra rules below. Runs as the Mend Renovate GitHub App. Pull
  // requests only, never automerge: every change still goes PR -> merge ->
  // tag (AGENTS.md).
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>bfeitknecht/infra//renovate/default.json5"],
  // Manifests live under kubernetes/; Flux HelmRelease, HelmRepository,
  // GitRepository and OCIRepository are read by the flux manager.
  flux: { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  kubernetes: { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  "helm-values": { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  ignorePaths: ["**/*.sops.yaml", "docs/**", ".private/**"],
  customManagers: [
    {
      // talos/topf.yaml: talosVersion and kubernetesVersion.
      customType: "regex",
      managerFilePatterns: ["/^talos/topf\\.yaml$/"],
      matchStrings: ["talosVersion: (?<currentValue>\\S+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "siderolabs/talos",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^talos/topf\\.yaml$/"],
      matchStrings: ["kubernetesVersion: (?<currentValue>\\S+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "kubernetes/kubernetes",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      // KnativeServing spec.version: the operator installs this Serving.
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/infrastructure/knative/serving/kserving\\.yaml$/"],
      matchStrings: ['version: "(?<currentValue>[0-9.]+)"'],
      datasourceTemplate: "github-tags",
      depNameTemplate: "knative/serving",
      extractVersionTemplate: "^knative-v(?<version>.*)$",
    },
    {
      // topf, built from source in nix/topf.nix. A bump also needs the two
      // hashes (see the file): approve in the dashboard, then fix by hand.
      customType: "regex",
      managerFilePatterns: ["/^nix/topf\\.nix$/"],
      matchStrings: ['version = "(?<currentValue>[0-9.]+)";'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "postfinance/topf",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
  ],
  packageRules: [
    // The pinned CRD GitRepository tags (cluster/crds.yaml) carry the chart
    // name as a prefix: without this versioning Renovate skips them.
    {
      matchDatasources: ["github-tags"],
      matchPackageNames: ["k8up-io/k8up"],
      versioning: "regex:^k8up-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      matchDatasources: ["github-tags"],
      matchPackageNames: ["prometheus-community/helm-charts"],
      versioning: "regex:^kube-prometheus-stack-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      matchDatasources: ["github-tags"],
      matchPackageNames: ["tg123/sshpiper-chart"],
      versioning: "regex:^sshpiper-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      matchDatasources: ["github-tags"],
      matchPackageNames: ["knative/operator"],
      versioning: "regex:^knative-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    // A chart (or operator image) and its pinned CRD tag move together
    // (AGENTS.md): one group each, for every update type.
    {
      groupName: "kube-prometheus-stack",
      matchPackageNames: ["kube-prometheus-stack", "prometheus-community/helm-charts"],
    },
    {
      groupName: "traefik",
      matchPackageNames: ["traefik", "traefik/traefik-helm-chart"],
    },
    {
      groupName: "k8up",
      matchPackageNames: ["k8up", "k8up-io/k8up"],
    },
    {
      groupName: "sshpiper",
      matchPackageNames: ["sshpiper", "tg123/sshpiper-chart"],
    },
    {
      groupName: "gateway-api",
      matchPackageNames: ["kubernetes-sigs/gateway-api"],
    },
    {
      groupName: "knative",
      matchPackageNames: ["gcr.io/knative-releases/knative.dev/operator/cmd/operator", "knative/operator", "knative/serving"],
    },
    {
      matchPackageNames: ["postfinance/topf"],
      dependencyDashboardApproval: true,
    },
    {
      // Database majors need a dump and restore (or pg_upgrade): by hand.
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/library/postgres", "ghcr.io/immich-app/postgres", "docker.io/valkey/valkey"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Old linuxserver tags look like majors (qbittorrent 14.x and 20.x, lidarr 8.x).
      matchPackageNames: ["lscr.io/linuxserver/qbittorrent"],
      allowedVersions: "<14",
    },
    {
      matchPackageNames: ["lscr.io/linuxserver/lidarr"],
      allowedVersions: "<8",
    },
    {
      groupName: "talos and kubernetes",
      matchPackageNames: ["siderolabs/talos", "kubernetes/kubernetes"],
      // One minor at a time, after a etcd snapshot: see the debugging playbook.
      separateMinorPatch: true,
    },
  ],
}
