   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(traefik_service_requests_total[5m])) > 0",
     "legendFormat": "{{service}}"
