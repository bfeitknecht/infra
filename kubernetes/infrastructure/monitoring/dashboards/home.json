     },
     "expr": "gotk_resource_info{ready!=\"True\",suspended!=\"true\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
