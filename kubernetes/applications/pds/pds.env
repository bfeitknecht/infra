# Non-secret PDS env config, mirroring the reference installer's pds.env.
# Secrets (PDS_JWT_SECRET, PDS_ADMIN_PASSWORD,
# PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX) come from the pds-secrets
# Secret via envFrom.
PDS_HOSTNAME=pds.0xbf.ch
# Vanity handles: accounts live at <name>.0xbf.ch (not under the PDS
# hostname). The same knob gates the /.well-known/atproto-did endpoint,
# which serves the handle -> DID mapping — no per-account DNS TXT needed.
PDS_SERVICE_HANDLE_DOMAINS=.0xbf.ch
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=314572800
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network
LOG_ENABLED=true
PDS_RATE_LIMITS_ENABLED=true
PDS_INVITE_REQUIRED=true