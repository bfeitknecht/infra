{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Ollama (rzbl)",
      "settings": {
        "baseURL": "http://ollama.ollama.svc.cluster.local:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B"
        }
      }
    },
    "anthropic": {
      "settings": {
        "apiKey": "{file:/etc/opencode-providers/anthropic}"
      }
    },
    "mistral": {
      "settings": {
        "apiKey": "{file:/etc/opencode-providers/mistral}"
      }
    },
    "openrouter": {
      "settings": {
        "apiKey": "{file:/etc/opencode-providers/openrouter}"
      }
    }
  },
  "model": "ollama/qwen2.5-coder:7b",
  "permissions": [
    {
      "action": "edit",
      "resource": "/nix/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/opt/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/etc/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/etc/opencode-providers/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/home/node/.local/share/opencode/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/home/node/.claude/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/home/node/.claude.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/etc/opencode-providers/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/etc/opencode-providers",
      "effect": "deny"
    }
  ],
  "update": "disable",
  "plugins": [
    "file:///opt/opencode-sandbox/node_modules/opencode-sandbox"
  ],
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": [
          "mcp-nixos"
        ]
      },
      "forgejo": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "FORGEJO_ACCESS_TOKEN=\"$(sed -E 's#^https://[^:]+:([^@]+)@.*#\\1#' /etc/opencode-git/git-credentials)\" exec forgejo-mcp --transport stdio --url https://git.0xbf.ch"
        ]
      }
    }
  }
}
