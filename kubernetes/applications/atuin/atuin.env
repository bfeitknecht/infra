# Non-secret Atuin server env config (ATUIN_* env overrides server.toml).
# No sops Secret needed: the SQLite server DB needs no credentials.
ATUIN_HOST=0.0.0.0
ATUIN_PORT=8888
# SQLite is a tier-one Atuin server database: single user, one PVC,
# Recreate strategy - same shape as forgejo/pds.
# The server creates the file on first boot.
ATUIN_DB_URI=sqlite:///config/atuin.db
# Open while the first user registers, then flip to false.
ATUIN_OPEN_REGISTRATION=true
RUST_LOG=atuin_server=info
